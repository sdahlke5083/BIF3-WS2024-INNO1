{{!
    @template block_compviz/skills_overview

    Displays total skill progress and individual skill/sub-skill progress bars.
    Styles and widths are responsive, no fixed widths used for skill/sub-skill bars.
}}

<div class="text-center mb-3">{{header}}</div>
<div class="d-flex flex-column">
    <!-- Total progress -->
    <div class="justify-content-center mb-4 text-center w-100" style="max-width: 280px;">
        <div class="text-muted">Total</div>
        <div class="pb pb-bar mb-2" style="--pb-progress: {{totalProgress}}%;--pb-fill-color: {{totalColor}};height: 40px;">
            <span class="pb-text bold" data-text="{{totalProgress}}%">{{totalProgress}}%</span>
        </div>
    </div>

    <!-- Skill list -->
    {{#skills}}
    <details>
        <summary class="skill-wrapper list-unstyled p-0 w-100">
            <div class="pb pb-bar mb-2 auto-color" style="--pb-progress: {{progress}}%;--pb-fill-color: {{color}};" data-toggle="tooltip" data-placement="left" title="{{name}}">
                <span class="pb-text bold" data-text="{{name}}">{{name}}</span>
                <span class="skill-toggle"></span>
            </div>
        </summary>

        <!-- Subskills: außerhalb, aber rechtsbündig an Skillbar ausgerichtet -->
        {{#grade_items}}
        <div class="d-flex justify-content-center ms-auto" style="width: 90%;">
            <div class="pb pb-bar mb-2 auto-color" style="--pb-progress: {{progress}}%;--pb-fill-color: {{color}};" data-toggle="tooltip" data-placement="left" title="{{name}}">
                <span class="pb-text bold" data-text="{{name}}">
                    {{#url}}
                        <a href="{{url}}" class="text-decoration-none">{{name}}</a>
                    {{/url}}
                    {{^url}}
                        {{name}}
                    {{/url}}
                </span>
            </div>
        </div>
        {{/grade_items}}
        {{^grade_items}}
        <div class="text-center text-muted mb-2">{{no_subskills}}</div>
        {{/grade_items}}

    </details>
    {{/skills}}
</div>