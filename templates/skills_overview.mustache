{{!
    @template block_compviz/skills_overview

    Displays total skill progress and individual skill/sub-skill progress bars.
    Styles and widths are responsive, no fixed widths used for skill/sub-skill bars.
}}

<div class="text-center mb-3">{{header}}</div>
<div class="d-flex flex-column">
    <!-- Total progress -->
    <div class="justify-content-center mb-4 text-center w-100" style="max-width: 280px;">
            <div class="text-muted">Total</div>
            <div class="position-relative bg-light border rounded" style="height: 40px;">
                <!-- Fortschritt -->
                <div class="position-absolute top-0 start-0 h-100 rounded" style="width: {{totalProgress}}%; background-color: {{totalColor}};"></div>

                <!-- Prozentanzeige zentriert -->
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center auto-color" style="--bg: {{totalColor}};">
                    {{totalProgress}}%
                </div>
            </div>
    </div>

    <!-- Skill list -->
    {{#skills}}
    <details>
        <summary class="list-unstyled p-0">
            <div class="skill-wrapper w-100">
                <div class="d-flex align-items-center bg-light border rounded position-relative mb-2" style="height: 35px;">
                    <div class="position-absolute top-0 start-0 h-100 rounded" style="width: {{progress}}%; background-color: {{color}};"></div>
                    <div class="position-relative w-100 d-flex align-items-center justify-content-center auto-color" style="--bg: {{color}};">
                        <div class="skill-name">{{name}}</div>
                        <span class="skill-toggle position-absolute end-0 me-2">▼</span>
                    </div>
                </div>
            </div>
        </summary>

        <!-- Subskills: außerhalb, aber rechtsbündig an Skillbar ausgerichtet -->
        {{#grade_items}}
        <div class="d-flex justify-content-center w-100">
            <div class="w-100">
                <div class="ms-auto" style="width: 90%;">
                    <div class="d-flex align-items-center bg-light border rounded position-relative mb-2" style="height: 35px;">
                        <div class="position-absolute top-0 start-0 h-100 rounded" style="width: {{progress}}%; background-color: {{color}};"></div>
                        <div class="position-relative w-100 d-flex align-items-center justify-content-center">
                            {{#url}}
                                <a href="{{url}}" class="sub-skill-name auto-color text-decoration-none" style="--bg: {{color}};">{{name}}</a>
                            {{/url}}
                            {{^url}}
                                <div class="sub-skill-name auto-color" style="--bg: {{color}};">{{name}}</div>
                            {{/url}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/grade_items}}

    </details>
    {{/skills}}
</div>