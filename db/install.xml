<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/compviz/db" VERSION="20250525" COMMENT="XMLDB file for Moodle blocks/compviz"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="block_compviz_colors" COMMENT="possible color-themes for the compviz bars">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="a short description of the color theme"/>
        <FIELD NAME="color1" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="hexcode of the color without the #"/>
        <FIELD NAME="color2" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="hexcode of the color without the #"/>
        <FIELD NAME="color3" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="hexcode of the color without the #"/>
        <FIELD NAME="color4" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="hexcode of the color without the #"/>
        <FIELD NAME="color5" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="hexcode of the color without the #"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
